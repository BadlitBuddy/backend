{
  "ConnectionStrings": {
    "Postgres": "postgresql://<USERNAME>:<PASSWORD>@localhost:5432/<DATABASE_NAME>",
    "Redis": "127.0.0.1:6379,password=<REDIS_PASSWORD>"
  },
  "S3Options": {
    "SecretKey": "<S3_SECRET_KEY>",
    "BucketName": "<S3_BUCKET_NAME>",
    "ApiUrl": "https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com",
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "AccessKey": "<S3_ACCESS_KEY>"
  },
  "Cloudflare": {
    "AccountId": "<CLOUDFLARE_ACCOUNT_ID>",
    "ApiKey": "<CLOUDFLARE_API_KEY>"
  },
  "TranscriptionWorker": {
    "TranscriptionProvider": 0
  },
  "HealthCheck": {
    "EnableHealthCheck": true,
    "Port": 8080,
    "Path": "/health"
  },
  "HangfireServer": {
    "WorkerCount": 1,
    "Queues": [
      "Default",
      "whisper-tiny-en"
    ]
  }
}
